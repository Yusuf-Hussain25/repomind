# OpenAI is required.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Optional: GitHub Personal Access Token. Without one, you're limited to
# 60 unauthenticated requests/hour from the API and may hit rate limits
# on large repos. Any classic token with "public_repo" scope works.
GITHUB_TOKEN=

# Pinecone (RAG for chat). When set, analyze auto-embeds the repo into
# Pinecone and chat does top-K retrieval instead of stuffing the whole repo.
# Without it, chat falls back to the pre-RAG full-context behavior.
# Free serverless tier works. The index is auto-created on first use
# (1536 dims, cosine, AWS us-east-1).
PINECONE_API_KEY=
# PINECONE_INDEX=repoinsight

# Redis (repo store, BullMQ job queue, chat memory, rate limits). Default
# points at the local docker-compose container on port 6380 (not 6379, to
# avoid colliding with any other Redis you may already be running).
# For deployment use a cloud Redis, e.g. Upstash: rediss://default:<pw>@<host>:6379
# Boot infra:  npm run infra:up    Run worker:  npm run worker
REDIS_URL=redis://127.0.0.1:6380
# WORKER_CONCURRENCY=3

# Public demo mode. When set, visitors can only chat with already-analyzed
# repos; adding repos and running analysis require this key (entered once
# in the repo form, then kept in an HttpOnly cookie). Leave unset locally.
# DEMO_ACCESS_KEY=
# Anonymous chat limits (ignored for the owner).
# CHAT_LIMIT_PER_HOUR=15
# CHAT_LIMIT_PER_DAY=300
